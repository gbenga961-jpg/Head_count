# Supabase Configuration
# The URL of your Supabase project (Public, safe for browser exposure)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# The Supabase publishable/anon API key (Public, safe for browser exposure; do NOT use secret or service_role keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key-here

